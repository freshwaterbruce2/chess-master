# Chess Master render-backend env example (no real secrets).
# Copy to render-backend/.env for local API runs, or set on Render.

PORT=3107

# Chess-only Gemini (never Tutor OpenRouter; never VITE_* / client-embedded keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kill switch for POST /api/chess/advice (default false).
# Missing / empty / false → 503 reject all advice.
# Enable on Render only when ready: AI_TUTOR_ENABLED=true
# Do not commit true.
AI_TUTOR_ENABLED=false

# Per-install usage caps. Tracked via request header:
#   X-Chess-Install-Id: opaque id (UUID), persisted under render-backend/data/ai-usage.json
# Defaults: 40 requests/day and 800/month per install id.
AI_DAILY_CAP=40
AI_MONTHLY_CAP=800

# Optional: extra browser origins (comma-separated). Capacitor + localhost included by default.
# ALLOWED_ORIGINS=https://your-app.example
