# Frontend: Chess Master tutor API base URL (no trailing slash).
# Client never embeds provider API keys — only this public backend URL.
# For USB phone testing, use your LAN/backend address after device setup.
VITE_CHESS_API_URL="http://127.0.0.1:3107"

# Public app URL when the web app is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# render-backend (set these on the Render service env — NOT as VITE_* client vars)
# -----------------------------------------------------------------------------
# Chess-only Gemini key (server-side). Never put this in VITE_* or the client.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Kill switch for POST /api/chess/advice. Default OFF.
# Missing / empty / false → all advice requests return 503.
# Do NOT commit AI_TUTOR_ENABLED=true. Enable only on Render when ready:
#   AI_TUTOR_ENABLED=true
AI_TUTOR_ENABLED=false

# Per-install caps (header: X-Chess-Install-Id). Defaults: 40/day, 800/month.
AI_DAILY_CAP=40
AI_MONTHLY_CAP=800

# Optional CORS extras (comma-separated). Localhost + Capacitor origins are built-in.
# ALLOWED_ORIGINS=https://your-frontend.example
